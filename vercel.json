{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "public/samples/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/auth/callback", "destination": "/api/index" },
    { "source": "/auth/callback/", "destination": "/api/index" },
    { "source": "/((?!api/|assets/|samples/|.*\\..*).*)", "destination": "/index.html" }
  ]
}

# =============================================================================
# ShortsForge AI — Environment Variables
# Copy to .env for local development or configure in Vercel Project Settings ->
# Environment Variables for production / preview deployments.
# =============================================================================

# GEMINI_API_KEY: Required for live Gemini AI endpoints (copywriter, retention
# surgery, hook optimizer, thumbnails, localization, etc.). Falls back to
# deterministic responses when unset.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PIXABAY_API_KEY: Live commercial-license video search for World Wonders.
# (Already configured in local .env; add the same key in Vercel Env Vars.)
PIXABAY_API_KEY=""

# PEXELS_API_KEY: Optional second stock video provider for World Wonders.
# Leave empty if not using Pexels.
PEXELS_API_KEY=""

# APP_URL: Public deployment origin used for Wise OAuth redirect URIs
# (e.g. https://shortsforge.vercel.app). Optional on Vercel — automatically
# falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL / request host.
APP_URL=""

# WISE_CLIENT_ID: Optional Wise OAuth client ID (defaults to sandbox client ID).
WISE_CLIENT_ID=""

# =============================================================================
# YouTube Data API v3 OAuth Credentials (for real resumable uploads via
# POST /api/youtube/upload). Leave empty to keep simulated upload fallback.
# Create OAuth 2.0 Client ID (Web application) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# =============================================================================
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
# Optional explicit OAuth redirect URI override. Defaults to
# <APP_URL or deployment origin>/api/youtube/oauth/callback
YOUTUBE_REDIRECT_URI=""

# PORT: Local standalone/dev Express server port (unused on Vercel serverless).
PORT="3000"

# NODE_ENV: Set to "production" for standalone Express serving dist/.
NODE_ENV="development"

# DISABLE_HMR: Dev-only flag to disable Vite HMR/watching in sandboxed previews.
DISABLE_HMR="false"
